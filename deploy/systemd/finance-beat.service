[Unit]
Description=Finance Tweet Analyzer Celery Beat
After=network-online.target finance-worker.service
Wants=network-online.target
PartOf=finance-app.target

[Service]
Type=simple
WorkingDirectory=/data/finance-tweet-analyzer
EnvironmentFile=/data/finance-tweet-analyzer/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/data/finance-tweet-analyzer/.venv/bin/celery -A app.celery_app beat -l info
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=finance-app.target
