[Unit]
Description=Finance Tweet Analyzer Celery Default Worker
After=network-online.target
Wants=network-online.target
PartOf=finance-app.target

[Service]
Type=simple
WorkingDirectory=/data/finance-tweet-analyzer
EnvironmentFile=/data/finance-tweet-analyzer/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/data/finance-tweet-analyzer/.venv/bin/celery -A app.celery_app worker --hostname=default@%H -Q default --concurrency=1 -l info
Restart=always
RestartSec=5
TimeoutStopSec=60

[Install]
WantedBy=finance-app.target
