[Unit]
Description=Finance Tweet Analyzer API
After=network-online.target
Wants=network-online.target
PartOf=finance-app.target

[Service]
Type=simple
WorkingDirectory=/data/finance-tweet-analyzer
EnvironmentFile=/data/finance-tweet-analyzer/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/data/finance-tweet-analyzer/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=finance-app.target
