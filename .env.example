# ============================================================
# Finance Tweet Analyzer — 环境变量模板
# ============================================================
# 复制本文件为 .env 并填入真实值：
#   cp .env.example .env
#
# 所有敏感信息（密钥、密码、Token）必须且只能通过 .env 注入，
# 代码中不包含任何硬编码凭据。
# ============================================================

# ----- Database -----
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/finance_tweets
# Tests perform destructive schema setup/teardown; this database name must end in _test.
TEST_DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/finance_tweets_test

# ----- OpenRouter LLM -----
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
HTTP_PROXY=

# ----- Models -----
SIGNAL_MODEL=qwen/qwen3.7-plus
REPORT_MODEL=qwen/qwen3.7-max
VISION_MODEL=qwen/qwen3.7-plus
VISION_PROMPT_VERSION=v1
VISION_MAX_IMAGES_PER_TWEET=4
VISION_MAX_IMAGE_DIMENSION=1600
VISION_JPEG_QUALITY=85
VISION_MAX_OUTPUT_TOKENS=5000

# ----- LangSmith (optional) -----
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finance-tweet-analyzer
LANGSMITH_TRACING=false

# ----- Scheduler -----
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=10

# ----- Redis & Celery -----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_PREDICTION_INTERVAL_MINUTES=5

# ----- RAG / Vector store -----
VECTOR_BACKEND=chroma
CHROMA_PERSIST_DIR=./chroma_db
# When using Zilliz Cloud / Milvus:
# VECTOR_BACKEND=milvus
# MILVUS_URI=https://your-cluster-public-endpoint.cloud.zilliz.com
# MILVUS_TOKEN=your-zilliz-api-key
# MILVUS_DB_NAME=default
# MILVUS_COLLECTION_PREFIX=finance_tweet
# MILVUS_TIMEOUT_SEC=30

# ----- Elasticsearch keyword retrieval (optional RAG BM25 backend) -----
RAG_KEYWORD_BACKEND=elasticsearch
# ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_USERNAME=es_admin
# ELASTICSEARCH_PASSWORD=your-es-password
# ES_RAG_INDEX=finance_rag_chunks
# ES_REQUEST_TIMEOUT_SEC=3
# ES_BULK_CHUNK_SIZE=500

# ----- DashScope (embedding + rerank) -----
DASHSCOPE_API_KEY=sk-your-dashscope-key

# ----- JWT Auth -----
JWT_SECRET_KEY=generate-a-random-secret-here
ADMIN_USER_IDS=[]
MAX_FOLLOWED_BLOGGERS_PER_USER=20
USER_ANALYSIS_REQUESTS_ENABLED=false
USER_ANALYSIS_DAILY_LIMIT=10
USER_ANALYSIS_PIPELINE_VERSION=v1
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://192.168.31.156:3000"]
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ----- Twitter API -----
TWITTER_AUTH_TOKEN=your_twitter_auth_token
TWITTER_CT0=your_twitter_ct0_csrf_token
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# ----- Financial instrument validation -----
INSTRUMENT_VALIDATION_ENABLED=true
INSTRUMENT_CATALOG_CACHE_SECONDS=43200
INSTRUMENT_API_TIMEOUT_SECONDS=10
AKSHARE_VALIDATION_ENABLED=true
OPENFIGI_VALIDATION_ENABLED=true
OPENFIGI_BASE_URL=https://api.openfigi.com/v3
# Optional; OpenFIGI works without a key at lower rate limits.
OPENFIGI_API_KEY=
SEC_EDGAR_VALIDATION_ENABLED=true
SEC_COMPANY_TICKERS_URL=https://www.sec.gov/files/company_tickers_exchange.json
# SEC requires an identifying application name and contact address.
SEC_USER_AGENT=finance-tweet-analyzer/0.1 your-email@example.com
BINANCE_VALIDATION_ENABLED=true
BINANCE_EXCHANGE_INFO_URL=https://data-api.binance.vision/api/v3/exchangeInfo
BINANCE_KLINES_URL=https://data-api.binance.vision/api/v3/klines
# Free official EIA Open Data key: https://www.eia.gov/opendata/register.php
EIA_API_KEY=
EIA_BASE_URL=https://api.eia.gov/v2
EIA_WTI_SERIES_ID=PET.RWTC.D

# Automatic prediction verification writes due results only when explicitly enabled.
AUTO_VERIFICATION_ENABLED=false
AUTO_VERIFICATION_INTERVAL_MINUTES=60
AUTO_VERIFICATION_BATCH_SIZE=50
AUTO_VERIFICATION_SHORT_RETURN_THRESHOLD=0.03
AUTO_VERIFICATION_MEDIUM_RETURN_THRESHOLD=0.05
AUTO_VERIFICATION_LONG_RETURN_THRESHOLD=0.10
GOLD_VERIFICATION_SHORT_RETURN_THRESHOLD=0.015
GOLD_VERIFICATION_MEDIUM_RETURN_THRESHOLD=0.03
GOLD_VERIFICATION_LONG_RETURN_THRESHOLD=0.06
AUTO_VERIFICATION_RETRY_HOURS=6

# ----- Storage -----
DOCUMENT_STORAGE_ROOT=./uploads
OBJECT_STORAGE_BACKEND=local
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET_DOCUMENTS=finance-documents
MINIO_BUCKET_TWEET_MEDIA=finance-tweet-media
TWEET_MEDIA_MAX_SIZE_MB=10

# ----- Feature flag -----
FEATURE_RAG_ENABLED=true

# ----- mem0 long-term memory -----
MEM0_ENABLED=true
MEM0_VECTOR_BACKEND=chroma
# When using Milvus for mem0 memory, reuse MILVUS_URI / MILVUS_TOKEN / MILVUS_DB_NAME.
# MEM0_VECTOR_BACKEND=milvus
# MEM0_MILVUS_COLLECTION=finance_tweet_mem0_memories
# MEM0_MILVUS_METRIC_TYPE=COSINE

# ----- Debug -----
DEBUG_MODE=false
LOG_JSON=false
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false
